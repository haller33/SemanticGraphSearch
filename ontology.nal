// Top-Level Entity (BFO)
< continuant --> entity >.
< occurrent --> entity >.

// Disjointness at Top-Level
< continuant --> (--, occurrent) >.
< occurrent --> (--, continuant) >.

// Continuant Taxonomy
< independent_continuant --> continuant >.
< dependent_continuant --> continuant >.
< spatial_region --> continuant >.

// Disjointness of Continuants
< independent_continuant --> (--, dependent_continuant) >.
< independent_continuant --> (--, spatial_region) >.
< dependent_continuant --> (--, spatial_region) >.

// Independent Continuant Sub-categories
< material_entity --> independent_continuant >.
< immaterial_entity --> independent_continuant >.
< material_entity --> (--, immaterial_entity) >.

// Material Entities
< object --> material_entity >.
< fiat_object_part --> material_entity >.
< object_aggregate --> material_entity >.

// Dependent Continuant Sub-categories
< specifically_dependent_continuant --> dependent_continuant >.
< generically_dependent_continuant --> dependent_continuant >.
< specifically_dependent_continuant --> (--, generically_dependent_continuant) >.

// Specifically Dependent Continuants
< quality --> specifically_dependent_continuant >.
< realizable_entity --> specifically_dependent_continuant >.
< quality --> (--, realizable_entity) >.

// Realizable Entities
< role --> realizable_entity >.
< disposition --> realizable_entity >.
< function --> disposition >.
< role --> (--, disposition) >.

// Occurrent Taxonomy
< process --> occurrent >.
< process_boundary --> occurrent >.
< spatiotemporal_region --> occurrent >.
< temporal_region --> occurrent >.

// Core BFO Relations (NAL Product Syntax for Relational Concepts)
// Parthood (Mereology)
< (continuant * continuant) --> part_of >.
< (occurrent * occurrent) --> part_of >.
< (spatial_region * spatial_region) --> part_of >.
< (temporal_region * temporal_region) --> part_of >.

// Participation
< (continuant * occurrent) --> participates_in >.
< (independent_continuant * process) --> participates_in >.

// Location
< (independent_continuant * spatial_region) --> located_in >.

// Occupation
< (occurrent * spatiotemporal_region) --> occupies >.
< (process * temporal_region) --> occupies >.

// Inherence (Dependent Continuants)
< (specifically_dependent_continuant * independent_continuant) --> inheres_in >.
< (quality * independent_continuant) --> inheres_in >.

// Realization
< (realizable_entity * process) --> realized_in >.
< (role * process) --> realized_in >.
< (disposition * process) --> realized_in >.

// Concretization
< (generically_dependent_continuant * specifically_dependent_continuant) --> concretized_in >.

// Examples of logical implications based on BFO semantics in NAL
// If a process realizes a disposition, then the process occurs and the disposition inheres in a participant
// < (&&, < (#1 * #2) --> realized_in >, < #1 --> disposition >, < #2 --> process >) ==> < (#3 * #2) --> participates_in > >.
// < (&&, < (#1 * #2) --> inheres_in >, < #2 --> independent_continuant >) ==> < #1 --> specifically_dependent_continuant > >.
